{
  "name": "brightbulb",
  "productName": "BrightBulb",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Control Philips Hue lights and mirror your screen onto them",
  "license": "GPL-3.0-only",
  "author": "Lucasion",
  "homepage": "https://github.com/LucasionGS/brightbulb",
  "desktopName": "io.github.brightbulb.BrightBulb.desktop",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "spike:dtls": "ELECTRON_RUN_AS_NODE=1 electron --no-warnings scripts/spikeDtls.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.55.0",
    "multicast-dns": "^7.2.5",
    "node-dtls-client": "^2.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.7.9",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
