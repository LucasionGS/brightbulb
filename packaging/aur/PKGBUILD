# Maintainer: Lucas <lucasion@hotmail.com>

pkgname=brightbulb-git
_pkgname=brightbulb
# Placeholder: aur-publish.sh patches this to the real r<count>.<hash> before
# generating .SRCINFO. Keep it in the r-scheme — a bare 0.1.0 would sort *newer*
# than every r-version if it ever reached the AUR unpatched.
pkgver=r0.0000000
pkgrel=1
pkgdesc="Open source Philips Hue control center with screen mirroring (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/LucasionGS/brightbulb"
license=('GPL-3.0-or-later')
depends=(
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'gstreamer'
    'gst-plugins-base'
    'gst-plugin-pipewire'
    'gst-python'
    'libsecret'
    'openssl'
    'python-numpy'
    'python-aiohttp'
    'python-zeroconf'
    'python-aiohue'
    'xdg-desktop-portal'
)
makedepends=(
    'git'
    'rust'
    'maturin'
    'python-build'
    'python-installer'
    'python-hatchling'
    'python-wheel'
)
optdepends=(
    'xdg-desktop-portal-hyprland: screen capture on Hyprland'
    'xdg-desktop-portal-wlr: screen capture on wlroots compositors'
    'xdg-desktop-portal-gnome: screen capture on GNOME'
    'gnome-keyring: stores the bridge credentials in a keyring'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+https://github.com/LucasionGS/brightbulb.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    if git describe --long --tags >/dev/null 2>&1; then
        git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

package() {
    make -C "$srcdir/$_pkgname" DESTDIR="$pkgdir" PREFIX=/usr PKGNAME="$pkgname" install
}
