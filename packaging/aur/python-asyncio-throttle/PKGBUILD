# Maintainer: Lucas <lucasion@hotmail.com>

# Dependency of python-aiohue, which BrightBulb needs. Neither is in the Arch
# repos or the AUR, and Arch packaging guidelines rule out vendoring them into
# brightbulb itself, so both are published as their own packages.

_name=asyncio-throttle
pkgname=python-asyncio-throttle
pkgver=1.0.2
pkgrel=1
pkgdesc="Simple, easy-to-use throttler for asyncio"
arch=('any')
url="https://github.com/hallazzang/asyncio-throttle"
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/${_name}/${_name}-${pkgver}.tar.gz")
sha256sums=('2675282e99d9129ecc446f917e174bc205c65e36c602aa18603b4948567fcbd4')

build() {
    cd "${_name}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${_name}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # The sdist ships no LICENSE file, so record the MIT terms from the project
    # metadata rather than leaving the package without one.
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    else
        install -Dm644 PKG-INFO "$pkgdir/usr/share/licenses/$pkgname/PKG-INFO"
    fi
}
