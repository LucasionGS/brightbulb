# Maintainer: Lucas <lucasion@hotmail.com>

# BrightBulb's Hue CLIP v2 client. Not in the Arch repos or the AUR, and Arch
# packaging guidelines rule out vendoring it into brightbulb itself.

_name=aiohue
pkgname=python-aiohue
pkgver=4.9.0
pkgrel=1
pkgdesc="Asynchronous library to control Philips Hue bridges (CLIP v1 and v2)"
arch=('any')
url="https://github.com/home-assistant-libs/aiohue"
license=('Apache-2.0')
depends=(
    'python'
    'python-aiohttp'
    'python-asyncio-throttle'
    'python-awesomeversion'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/${_name}/${_name}-${pkgver}.tar.gz")
sha256sums=('c1c5edf114266f6b5878ffccf82db8b326141cc3d8c3697f5fc3aa87a4d3747e')

build() {
    cd "${_name}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${_name}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
